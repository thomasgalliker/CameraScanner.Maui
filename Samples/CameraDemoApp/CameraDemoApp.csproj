<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CameraDemoApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <MauiVersion>10.0.70</MauiVersion>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>Camera Scanner SDK</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>ch.superdev.camerascanner</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>

    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU;Simulator;Device</Platforms>

    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon
      IsAppIcon="true"
      Include="Resources\AppIcon\appicon.png"
      Condition="$(TargetFramework.Contains('-android'))"
      ForegroundScale="0.65"
      Resize="True"
      Color="#FFFFFF" />
    <MauiIcon
      IsAppIcon="true"
      Include="Resources\AppIcon\appicon.png"
      Condition="$(TargetFramework.Contains('-ios'))"
      ForegroundScale="1"
      Resize="True"
      Color="#FFFFFF" />
    
    <!-- Splash Screen -->
    <MauiSplashScreen 
      Include="Resources\Splash\splash.png"
      Condition="$(TargetFramework.Contains('-android'))"
      BaseSize="512,512"
      Resize="True"
      Color="#FFFFFF" />
    <MauiSplashScreen 
      Include="Resources\Splash\splash.png"
      Condition="$(TargetFramework.Contains('-ios'))"
      BaseSize="128,128"
      Resize="True"
      Color="#FFFFFF" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    
    <!-- Sound -->
    <None Remove="Resources\Sound\**" />
    <EmbeddedResource Include="Resources\Sound\*" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

  </ItemGroup>

  <!-- Android build properties -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion> <!-- android:minSdkVersion -->
    <!--<TargetPlatformVersion>35</TargetPlatformVersion>  android:targetSdkVersion -->
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <UseInterpreter>false</UseInterpreter>
    <AndroidUseAapt2>true</AndroidUseAapt2>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Debug'">
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <JavaMaximumHeapSize>1G</JavaMaximumHeapSize>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
  </PropertyGroup>

  <!-- iOS build properties -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion> <!-- MinimumOSVersion -->
    <ConsolePause>false</ConsolePause>
    <CodesignKey>iPhone Developer</CodesignKey>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Platform)' == 'Simulator'">
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Platform)' == 'Device'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Configuration)' == 'Debug'">
    <MtouchDebug>true</MtouchDebug>
    <CreatePackage>false</CreatePackage>
    <ProvisioningType>automatic</ProvisioningType>
    <CodesignProvision />
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Configuration)' == 'Release'">
    <MtouchDebug>false</MtouchDebug>
    <CreatePackage>true</CreatePackage>
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <MtouchUseLlvm>true</MtouchUseLlvm>
    <MtouchLink>SdkOnly</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="14.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.1.3" />
    <PackageReference Include="ObjectDumper.NET" Version="4.4.13-pre" />
    <PackageReference Include="ResourceLoader" Version="3.4.5-pre" />
    <PackageReference Include="Sentry.Maui" Version="6.6.0" />
    <PackageReference Include="Superdev.Maui" Version="1.2.40-pre" />
    <PackageReference Include="ValueConverters.MAUI" Version="4.2.8-pre" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CameraScanner.Maui\CameraScanner.Maui.csproj" />
  </ItemGroup>

  <Target Name="PrintVariables" BeforeTargets="Build">
    <Message Importance="high" Text="----------------------" />
    <Message Importance="high" Text="PrintVariables for $(TargetFramework)" />
    <Message Importance="high" Text="Configuration: $(Configuration)" />
    <Message Importance="high" Text="Platform: $(Platform)" />
    <Message Importance="high" Text="PlatformTarget: $(PlatformTarget)" />
    <Message Importance="high" Text="TargetFramework: $(TargetFramework)" />
    <Message Importance="high" Text="RuntimeIdentifier: $(RuntimeIdentifier)" />
    <Message Importance="high" Text="SupportedOSPlatformVersion: $(SupportedOSPlatformVersion)" />
    <Message Importance="high" Text="OutputPath: $(OutputPath)" />
    <Message Importance="high" Text="ApplicationId: $(ApplicationId)" />
    <Message Importance="high" Text="ApplicationTitle: $(ApplicationTitle)" />
    <Message Importance="high" Text="ApplicationDisplayVersion: $(ApplicationDisplayVersion)" />
    <Message Importance="high" Text="ApplicationVersion: $(ApplicationVersion)" />
    <Message Importance="high" Text="ProvisioningType: $(ProvisioningType)" Condition="$(TargetFramework.Contains('-ios'))" />
    <Message Importance="high" Text="CodesignKey: $(CodesignKey)" Condition="$(TargetFramework.Contains('-ios'))" />
    <Message Importance="high" Text="CodesignProvision: $(CodesignProvision)" Condition="$(TargetFramework.Contains('-ios'))" />
    <Message Importance="high" Text="CodesignEntitlements: $(CodesignEntitlements)" Condition="$(TargetFramework.Contains('-ios'))" />
    <Message Importance="high" Text="EmbedAssembliesIntoApk: $(EmbedAssembliesIntoApk)" Condition="$(TargetFramework.Contains('-android'))" />
    <Message Importance="high" Text="JavaMaximumHeapSize: $(JavaMaximumHeapSize)" Condition="$(TargetFramework.Contains('-android'))" />
    <Message Importance="high" Text="DebugSymbols: $(DebugSymbols)" />
    <Message Importance="high" Text="DebugType: $(DebugType)" />
    <Message Importance="high" Text="Optimize: $(Optimize)" />
    <Message Importance="high" Text="----------------------" />
  </Target>
  
</Project>
